# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and never committed — this file only documents what's needed.

# Server-side only. Used exclusively by src/app/api/assistant/route.ts (a Next.js Route Handler
# that runs on the server, never in the browser). If left blank, the AI Assistant, Onboarding's
# "Ask AI to elaborate", and the Analytics Executive Brief all fall back to realistic mock
# responses automatically — the app is fully demoable without this key.
GROQ_API_KEY=your_server_side_key_here

# Optional. Defaults to openai/gpt-oss-20b if unset.
GROQ_MODEL=openai/gpt-oss-20b
